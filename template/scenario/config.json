{
  "override_hint_style": "# <=== [Override]",
  "senario_env_key": "SCENARIO_TYPE",
  "top_level_spacing": 1,
  "default_base": "general_cluster",
  "default_env_vars": [
    {
      "key": "FAB",
      "description": "This var is describe the fab of the cluster.\n Example: fab200mm"
    },
    {
      "key": "SERVICE",
      "description": "This var is describe the service of the cluster."
    },
    {
      "key": "CLUSTER_NAME",
      "description": "This var is describe the name of the cluster."
    }
  ],
  "senarios": [
    {
      "value": "general_cluster",
      "path": "template/scenario/default",
      "required_env_vars": [
        {
          "key": "OWNER",
          "description": "who is cluster owner"
        }
      ],
      "is_base": true,
      "trigger": {
        "source": "user"
      }
    },
    {
      "value": "f200",
      "path": "template/scenario/fab200mm",
      "required_env_vars": [],
      "priority": 1,
      "applies_to": ["general_cluster", "tvm"],
      "trigger": {
        "source": "env",
        "logic": "and",
        "conditions": [
          {
            "key": "FAB",
            "regex": "200mm"
          }
        ]
      }
    },
    {
      "value": "tvm",
      "path": "template/scenario/tvm",
      "required_env_vars": [
        {
          "key": "TVM_FAB",
          "description": "This var is describe the where is tvm cluster."
        },
        {
          "key": "TVM_CILIUM",
          "description": "This var is describe the where is tvm's cilium."
        }
      ],
      "is_base": true,
      "trigger": {
        "source": "user"
      }
    },
    {
      "value": "multitenant",
      "path": "template/scenario/multitenant",
      "required_env_vars": [],
      "priority": 3,
      "applies_to": ["general_cluster"],
      "trigger": {
        "source": "user"
      }
    },
    {
      "value": "example",
      "path": "template/scenario/multitenant",
      "required_env_vars": [
        {
          "key": "EXAMPLE_VARs",
          "description": "This is an exmaple scenario."
        }
      ],
      "priority": 999,
      "applies_to": ["general_cluster"],
      "trigger": {
        "source": "user"
      }
    }
  ]
}
